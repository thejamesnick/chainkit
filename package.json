{
  "name": "chainkit",
  "version": "0.1.0",
  "description": "Universal SDK wrapper for blockchain APIs. Solana-first.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./solana": {
      "import": "./dist/chains/solana/index.js",
      "types": "./dist/chains/solana/index.d.ts"
    },
    "./wallet": {
      "import": "./dist/wallet/index.js",
      "types": "./dist/wallet/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest --run"
  },
  "keywords": ["solana", "blockchain", "sdk", "rpc", "web3", "chainkit"],
  "author": "thejamesnick",
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "bip39": "^3.1.0",
    "ed25519-hd-key": "^1.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.0.0",
    "vitest": "^4.1.4"
  }
}
